<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="9ae100c8-a398-4072-aae2-f2a8c6a8dda5" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>Tests</name>
  <description />
  <settings>
    <options>
      <option name="shouldFailBuildOnAnyErrorMessage" value="true" />
    </options>
    <disabled-settings>
      <setting-ref ref="Assets_Install" />
      <setting-ref ref="Cache_Clear" />
      <setting-ref ref="DockerCompose" />
      <setting-ref ref="Importmap_Install" />
    </disabled-settings>
    <build-runners>
      <runner id="Dev_Init_PHP_Container" name="Init PHP Container" type="simpleRunner">
        <parameters>
          <param name="script.content" value="docker compose -f compose.yaml -f compose.override.yaml -p teamcity-%teamcity.agent.name% up -d php" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="Composer_Install" name="Composer Install" type="simpleRunner">
        <parameters>
          <param name="plugin.docker.imagePlatform" value="linux" />
          <param name="script.content" value="docker exec teamcity-php-1 composer install --verbose --no-progress --no-interaction --no-scripts" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="Dev_Generate_env_docker" name="Generate .env.docker" type="simpleRunner">
        <parameters>
          <param name="plugin.docker.imagePlatform" value="linux" />
          <param name="script.content" value="docker exec teamcity-php-1 composer dev:dump:env" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="Cache_Clear" name="Cache Clear" type="simpleRunner">
        <parameters>
          <param name="script.content" value="docker exec teamcity-php-1 php bin/console cache:clear" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="Assets_Install" name="Assets Install" type="simpleRunner">
        <parameters>
          <param name="script.content" value="docker exec teamcity-php-1 php bin/console assets:install" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="Importmap_Install" name="Importmap Install" type="simpleRunner">
        <parameters>
          <param name="script.content" value="docker exec teamcity-php-1 php bin/console importmap:install" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="DockerCompose" name="Tests: Docker Compose" type="DockerCompose">
        <parameters>
          <param name="dockerCompose.file" value="compose.yaml compose.override.yaml" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="ProyectoFinCiclo_HttpsGithubComIdmarinasProyectoFinCicloRefsHeadsMaster1" />
    </vcs-settings>
    <build-triggers>
      <build-trigger id="TRIGGER_2" type="vcsTrigger">
        <parameters>
          <param name="branchFilter" value="+:*" />
          <param name="enableQueueOptimization" value="true" />
          <param name="quietPeriodMode" value="DO_NOT_USE" />
        </parameters>
      </build-trigger>
    </build-triggers>
    <build-extensions>
      <extension id="perfmon" type="perfmon">
        <parameters>
          <param name="teamcity.perfmon.feature.enabled" value="true" />
        </parameters>
      </extension>
      <extension id="BUILD_EXT_1" type="BuildFailureOnMessage">
        <parameters>
          <param name="buildFailureOnMessage.conditionType" value="contains" />
          <param name="buildFailureOnMessage.messagePattern" value="PHP Fatal error" />
          <param name="buildFailureOnMessage.reverse" value="false" />
          <param name="buildFailureOnMessage.stopBuildOnFailure" value="true" />
        </parameters>
      </extension>
    </build-extensions>
  </settings>
</build-type>

