{
  "name": "idmarinas/proyecto-fin-ciclo",
  "description": "Foro de Ayuda y Soporte para clientes y usuarios.",
  "type": "project",
  "homepage": "https://github.com/idmarinas/proyecto-fin-ciclo",
  "authors": [
    {
      "name": "Iván Diaz Marinas (IDMarinas)",
      "email": "35842929+idmarinas@users.noreply.github.com",
      "role": "Author, Developer, Maintainer"
    }
  ],
  "support": {
    "issues": "https://github.com/idmarinas/proyecto-fin-ciclo/issues"
  },
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.6",
    "easycorp/easyadmin-bundle": "^4.27",
    "idmarinas/seo-bundle": "1.x-dev",
    "idmarinas/ui-bundle": "1.x-dev",
    "nelmio/security-bundle": "^3.7",
    "phpdocumentor/reflection-docblock": "^5.6",
    "phpstan/phpdoc-parser": "^2.3",
    "stof/doctrine-extensions-bundle": "^1.15",
    "symfony/asset": "8.0.*",
    "symfony/asset-mapper": "8.0.*",
    "symfony/console": "8.0.*",
    "symfony/doctrine-messenger": "8.0.*",
    "symfony/dotenv": "8.0.*",
    "symfony/expression-language": "8.0.*",
    "symfony/flex": "^2",
    "symfony/form": "8.0.*",
    "symfony/framework-bundle": "8.0.*",
    "symfony/http-client": "8.0.*",
    "symfony/intl": "8.0.*",
    "symfony/lock": "8.0.*",
    "symfony/mailer": "8.0.*",
    "symfony/mime": "8.0.*",
    "symfony/monolog-bundle": "^3.0|^4.0",
    "symfony/notifier": "8.0.*",
    "symfony/process": "8.0.*",
    "symfony/property-access": "8.0.*",
    "symfony/property-info": "8.0.*",
    "symfony/runtime": "8.0.*",
    "symfony/scheduler": "8.0.*",
    "symfony/security-bundle": "8.0.*",
    "symfony/serializer": "8.0.*",
    "symfony/stimulus-bundle": "^2.32",
    "symfony/string": "8.0.*",
    "symfony/translation": "8.0.*",
    "symfony/twig-bundle": "8.0.*",
    "symfony/ux-turbo": "^2.32",
    "symfony/validator": "8.0.*",
    "symfony/web-link": "8.0.*",
    "symfony/yaml": "8.0.*",
    "symfonycasts/tailwind-bundle": "^0.12.0",
    "twig/extra-bundle": "^2.12|^3.0",
    "twig/twig": "^2.12|^3.0"
  },
  "require-dev": {
    "dama/doctrine-test-bundle": "^8.4",
    "doctrine/doctrine-fixtures-bundle": "^4.3",
    "phpunit/phpunit": "^12.5",
    "rector/rector": "^2.3",
    "symfony/browser-kit": "8.0.*",
    "symfony/css-selector": "8.0.*",
    "symfony/debug-bundle": "8.0.*",
    "symfony/maker-bundle": "^1.0",
    "symfony/stopwatch": "8.0.*",
    "symfony/web-profiler-bundle": "8.0.*",
    "zenstruck/foundry": "^2.8"
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*",
    "symfony/polyfill-php83": "*",
    "symfony/polyfill-php84": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/",
      "DataFixtures\\": "tests/DataFixtures/",
      "Factory\\": "tests/Factory/"
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd",
      "importmap:install": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "test:fixtures:load": [
      "php bin/console doctrine:schema:drop --env=test --force --ansi",
      "php bin/console doctrine:schema:update --env=test --force --ansi",
      "php bin/console doctrine:fixtures:load --env=test -n --ansi"
    ],
    "dev:fixtures:load": [
      "php bin/console doctrine:schema:drop --env=dev --force --ansi",
      "php bin/console doctrine:schema:update --env=dev --force --ansi",
      "php bin/console doctrine:fixtures:load --env=dev -n --ansi"
    ],
    "dev:dump:env": [
      "php bin/console secrets:decrypt-to-local --force --env=dev",
      "@composer dump-env dev",
      "php -f .docker/scripts/create_env_file.php"
    ],
    "prod:dump:env": [
      "php bin/console secrets:decrypt-to-local --force --env=prod",
      "@composer dump-env prod",
      "php -f .docker/scripts/create_env_file.php"
    ]
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "bump-after-update": false,
    "sort-packages": true
  },
  "extra": {
    "symfony": {
      "allow-contrib": true,
      "require": "8.0.*",
      "docker": true
    }
  }
}
