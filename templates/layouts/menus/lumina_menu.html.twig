{% extends '@KnpMenu/menu.html.twig' %}

{% set orientation = options.orientation is defined ? options.orientation : 'horizontal' %}

{% block root %}
  {% set listAttributes = item.childrenAttributes|merge({
    class: orientation == 'horizontal' ? 'flex items-center space-x-2 relative' : 'space-y-1'
  }) %}
  {{ block('list') -}}
{% endblock %}

{% block item %}
  {% if item.displayed %}
    {# building the class of the item #}
    {%- set classes = item.attribute('class') is not empty ? [item.attribute('class')] : [] %}
    {%- if matcher.isCurrent(item) %}
      {%- set classes = classes|merge([options.currentClass]) %}
    {%- elseif matcher.isAncestor(item, options.matchingDepth) %}
      {%- set classes = classes|merge([options.ancestorClass]) %}
    {%- endif %}
    {%- if item.actsLikeFirst %}
      {%- set classes = classes|merge([options.firstClass]) %}
    {%- endif %}
    {%- if item.actsLikeLast %}
      {%- set classes = classes|merge([options.lastClass]) %}
    {%- endif %}

    {# Mark item as "leaf" (no children) or as "branch" (has children that are displayed) #}
    {% if item.hasChildren and options.depth is not same as(0) %}
      {% if options.branch_class is not empty and item.displayChildren %}
        {%- set classes = classes|merge([options.branch_class]) %}
      {% endif %}
    {% elseif options.leaf_class is not empty %}
      {%- set classes = classes|merge([options.leaf_class]) %}
    {%- endif %}

    {% set classes = classes|merge([orientation == 'horizontal' ? 'inline-block mx-1' : 'my-1']) %}

    {%- set attributes = item.attributes %}
    {%- if classes is not empty %}
      {%- set attributes = attributes|merge({class: classes|join(' ')}) %}
    {%- endif %}
    {# displaying the item #}
    {% import _self as knp_menu %}

    {# Orientación por defecto #}
    {% set orientation = options.orientation is defined ? options.orientation : 'horizontal' %}

    {# Estados reales de KnpMenu #}
    {% set isCurrent = matcher.isCurrent(item) %}
    {% set isAncestor = matcher.isAncestor(item, options.matchingDepth) %}

    {% set baseClasses = [
      'px-4 py-2 rounded-lg text-sm transition-colors whitespace-nowrap',
      isCurrent
      ? 'bg-primary text-primary-foreground'
      : (isAncestor
      ? 'bg-primary/10 text-primary'
      : 'text-foreground hover:bg-accent hover:text-accent-foreground')
    ] %}

    {% set orientationClasses = orientation == 'horizontal' ? 'inline-flex items-center' : 'block' %}

    <li{{ knp_menu.attributes(attributes) }}>
      {%- if item.uri is not empty and (not matcher.isCurrent(item) or options.currentAsLink) %}
        {{ block('linkElement') }}
      {%- else %}
        {{ block('spanElement') }}
      {%- endif %}
      {# render the list of children #}
      {%- set childrenClasses = item.childrenAttribute('class') is not empty ? [item.childrenAttribute('class')] : [] %}
      {%- set childrenClasses = childrenClasses|merge(['menu_level_' ~ item.level]) %}
      {%- set childrenClasses = childrenClasses|merge([
        'mt-2 space-y-1',
        orientation == 'horizontal' ? 'absolute bg-background border border-border rounded-lg shadow-lg p-2' : 'ml-4 border-l border-border pl-3'
      ]) %}
      {%- set listAttributes = item.childrenAttributes|merge({class: childrenClasses|join(' ')}) %}

      {{ block('list') }}
    </li>
  {% endif %}
{% endblock %}

{% block linkElement %}
  {% import _self as knp_menu %}
  <a
      href="{{ item.uri }}"
      {{ knp_menu.attributes(item.linkAttributes|merge({class: (baseClasses|join(' ') ~ ' ' ~ orientationClasses)})) }}
  >
    {% if item.extra('icon') %}
      <twig:ux:icon name="{{ item.extra('icon') }}" class="size-4 inline-block mr-2 text-muted-foreground" />
    {% endif %}
    {{ block('label') }}
  </a>
{% endblock %}

{% block spanElement %}
  {% import _self as knp_menu %}
  <span{{ knp_menu.attributes(item.linkAttributes|merge({class: (baseClasses|join(' ') ~ ' ' ~ orientationClasses)
  })) }}>
    <twig:ux:icon name="{{ item.extra('icon') }}" class="size-4 inline-block mr-2 text-muted-foreground" />
    {{ block('label') }}
  </span>
{% endblock %}
