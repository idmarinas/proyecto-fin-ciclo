<!DOCTYPE html>
<html lang="{{ app.request.locale }}" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="distribution" content="global" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex,nofollow,noarchive" />

  <title>{% block title %}Exception Error{% endblock %}</title>

  <!-- Favicons -->
  <link rel="icon" href="/favicons/favicon.png" type="image/png">
  <link rel="icon" href="/favicons/favicon-32x32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/favicons/favicon-16x16.png" sizes="16x16" type="image/png">
  <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" sizes="180x180">
  <link rel="manifest" href="/site.webmanifest">

  {# Meta tags personalizados #}
  {% block header_meta %}{% endblock %}

  {# Importmaps personalizados #}
  {% block importmap %}
    {{ importmap('exception_error', { 'nonce': csp_nonce('script') }) }}
  {% endblock %}

  {% block stylesheets %}{% endblock %}

  {% block javascripts %}{% endblock %}
</head>
<body class="h-full w-full">
  {% block body %}
  {% endblock body %}
</body>
</html>
