{% extends 'base.html.twig' %}

{% block article %}
  <twig:Layout:Article>
    <twig:Layout:Section class="flex flex-col md:flex-row py-16">
      <div class="px-6 text-center flex-1">
        <h2 class="text-4xl font-extrabold text-blue-900">Foros principales</h2>
        <p class="mt-4 text-lg text-gray-600">
          Explora los foros padre y accede a sus subforos especializados.
          Encuentra soporte, comparte conocimientos y participa en la comunidad.
        </p>
      </div>

      <twig:Ui:Item as="a" href="{{ path('app_forums_rules') }}" class="w-full md:w-2xs">
        <twig:Ui:Item:Media variant="icon">{{ ux_icon('tabler:shield', {class: 'size-9'}) }}</twig:Ui:Item:Media>
        <twig:Ui:Item:Content>
          <twig:Ui:Item:Title><h3>Reglas de los foros</h3></twig:Ui:Item:Title>
          <twig:Ui:Item:Description>
            <ul class="grid grid-cols-2 md:grid-cols-1 gap-1">
              <li>Respeto entre usuarios</li>
              <li>No spam</li>
              <li>No publicar datos sensibles</li>
              <li>Usar títulos descriptivos</li>
            </ul>
          </twig:Ui:Item:Description>
        </twig:Ui:Item:Content>
      </twig:Ui:Item>
    </twig:Layout:Section>

    <twig:Ui:Separator class="mt-0" />

    <twig:Layout:Section>
      {% for forum in forums %}
        <twig:Ui:Card variant="full" class="overflow-hidden border shadow-sm bg-white rounded-xl">

          <div class="flex flex-col md:flex-row">

            <div class="md:w-1/4">
              {{ parse_img(forum.image, forum.title, { class: 'w-full h-full object-cover md:h-full' }) }}
            </div>

            <div class="md:w-3/4 p-6 space-y-4">

              <a href="{{ path('app_forums_forum', { slug: forum.slug }) }}" class="flex items-center gap-3">
                <twig:ux:icon name="tabler:folder" class="w-6 h-6 text-blue-700" />
                <h3 class="text-2xl font-bold text-blue-900">{{ forum.title }}</h3>
              </a>

              <p class="text-gray-600">
                {{ forum.description }}
              </p>

              <p class="text-sm text-gray-500 flex gap-4">
                <span>{{ forum.__children|length }} subforos</span>
                <span>{{ forum.totalThreads }} hilos</span>
                <span>{{ forum.totalMessages }} mensajes</span>
                <span>Última actividad: {{ forum.lastMessageAt|date("d/m/Y") }}</span>
              </p>

              <div class="flex flex-wrap gap-2">
                {% for sub in forum.__children %}
                  <twig:Ui:Badge
                      as="a"
                      variant="secondary"
                      href="{{ path('app_forums_forum_threads', { slug_forum: forum.slug, slug_subforum: sub.slug}) }}"
                  >{{ sub.title }}</twig:Ui:Badge>
                {% endfor %}
              </div>

              <twig:Ui:Button as="a" href="{{ path('app_forums_forum', { slug: forum.slug }) }}">
                <twig:ux:icon name="tabler:arrow-right" />
                Ver subforos
              </twig:Ui:Button>

            </div>

          </div>

        </twig:Ui:Card>
      {% else %}
        <twig:Ui:Alert variant="warning" class="p-5">
          <twig:ux:icon name="tabler:message-off" class="size-12" />
          <twig:Ui:Alert:Title>No hay foros todavía.</twig:Ui:Alert:Title>
          <twig:Ui:Alert:Description>
            Vuelve más tarde u otro día seguro que alguno tendremos.
          </twig:Ui:Alert:Description>
        </twig:Ui:Alert>
      {% endfor %}
    </twig:Layout:Section>
  </twig:Layout:Article>
  <twig:Layout:Aside>
    <twig:Layout:Sidebar />
  </twig:Layout:Aside>
{% endblock %}
