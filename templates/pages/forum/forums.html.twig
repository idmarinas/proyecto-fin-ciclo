{# @var subforum \App\Entity\Forum #}

{% extends 'base.html.twig' %}

{% block article %}
  <twig:Layout:Article>
    <twig:Layout:Section class="border-b">
      <twig:Ui:Item class="flex-col md:flex-row">
        <twig:Ui:Item:Media class="w-full md:w-auto">
          {{ parse_img(forum.image, forum.title, { class: 'w-full h-48 rounded-lg object-cover' }) }}
        </twig:Ui:Item:Media>
        <twig:Ui:Item:Content>
          <twig:Ui:Item:Title>
            <h1 class="text-2xl">
              <twig:ux:icon name="tabler:folder" class="size-8 inline-block" />
              {{ forum.title }}
            </h1>
          </twig:Ui:Item:Title>
          <twig:Ui:Item:Description>{{ forum.description }}</twig:Ui:Item:Description>
          <div class="grid grid-cols-2 md:grid-rows-2 md:grid-cols-1 gap-4 mt-2">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="flex items-center gap-2">
                <twig:ux:icon name="tabler:messages" class="text-blue-600 size-6" />
                <span>Hilos <twig:Ui:Badge class="bg-blue-100 text-blue-600">{{ forum.totalThreads }}</twig:Ui:Badge></span>
              </div>
              <div class="flex items-center gap-2">
                <twig:ux:icon name="tabler:message" class="text-blue-600 size-6" />
                <span>Mensajes: <twig:Ui:Badge class="bg-blue-100 text-blue-600">{{ forum.totalMessages }}</twig:Ui:Badge></span>
              </div>
              <div class="flex items-center gap-2 ">
                <twig:ux:icon name="tabler:message-dots" class="text-blue-600 size-6" />
                <span>Subforos <twig:Ui:Badge class="bg-blue-100 text-blue-600">{{ forum.children.count }}</twig:Ui:Badge></span>
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="flex items-center gap-2">
                <twig:ux:icon name="tabler:message-circle-check" class="text-green-600 size-6" />
                <span>Resueltos: <twig:Ui:Badge class="bg-green-100 text-green-600">{{ forum.threadsResolved }}</twig:Ui:Badge></span>
              </div>
              <div class="flex items-center gap-2">
                <twig:ux:icon name="tabler:message-circle-exclamation" class="text-yellow-600 size-6" />
                <span>En progreso: <twig:Ui:Badge class="bg-yellow-100 text-yellow-600">{{ forum.threadsInProgress }}</twig:Ui:Badge></span>
              </div>
              <div class="flex items-center gap-2">
                <twig:ux:icon name="tabler:message-circle-question" class="text-red-600 size-6" />
                <span>Sin respuesta: <twig:Ui:Badge class="bg-red-100 text-red-600">{{ forum.threadsOpen }}</twig:Ui:Badge></span>
              </div>
            </div>
          </div>
        </twig:Ui:Item:Content>
        <twig:Ui:Item:Footer>
          <div class="flex items-center gap-2 text-sm text-gray-600">
            <twig:ux:icon name="tabler:clock" class="w-4 h-4 text-blue-700" />
            Última actividad: {{ forum.lastMessageAt|date("d/m/Y") }}
          </div>
        </twig:Ui:Item:Footer>
      </twig:Ui:Item>
    </twig:Layout:Section>

    <twig:Layout:Section class="space-y-6">
      {# Lista de sub-foros #}
      {% for subforum in forum.children %}
        <twig:Ui:Item
            variant="outline"
            as="a"
            href="{{ path('app_forums_forum_threads', { slug_forum: forum.slug , slug_subforum: subforum.slug }) }}"
        >
          <twig:Ui:Item:Header>
            <div class="flex gap-4 text-muted-foreground">
              <div class="flex items-center gap-1 w-auto">
                <twig:ux:icon name="tabler:messages" class="size-4" />
                {{ subforum.totalThreads }} hilos
              </div>

              <div class="flex items-center gap-1">
                <twig:ux:icon name="tabler:message" class="size-4" />
                {{ subforum.totalMessages }} mensajes
              </div>
            </div>
          </twig:Ui:Item:Header>
          <twig:Ui:Item:Media class="w-full md:w-auto">
            {{ parse_img(forum.image, forum.title, { class: 'w-full h-40 rounded-lg object-cover' }) }}
          </twig:Ui:Item:Media>
          <twig:Ui:Item:Content>
            <twig:Ui:Item:Title>
              <twig:ux:icon name="tabler:folder-open" class="size-6 inline-block" />
              {{ subforum.title }}
              {% set days = (date()|date('U') - subforum.createdAt|date('U')) / 86400 %}
              <twig:App:Badge:LastActivity :days="days" />
            </twig:Ui:Item:Title>
            <twig:Ui:Item:Description>{{ subforum.description }}</twig:Ui:Item:Description>

            <div class="flex flex-wrap justify-between gap-4 mt-3">

              <div class="flex items-center gap-1 text-green-700">
                <twig:ux:icon name="tabler:check" class="w-4 h-4" />
                {{ subforum.threadsResolved }} resueltos
              </div>

              <div class="flex items-center gap-1 text-yellow-700">
                <twig:ux:icon name="tabler:clock" class="w-4 h-4" />
                {{ subforum.threadsInProgress }} en progreso
              </div>

              <div class="flex items-center gap-1 text-red-700">
                <twig:ux:icon name="tabler:alert-circle" class="w-4 h-4" />
                {{ subforum.threadsClosed }} cerrados
              </div>

            </div>
          </twig:Ui:Item:Content>
          <twig:Ui:Item:Actions />
          <twig:Ui:Item:Footer>
            <div class="flex items-center gap-1">
              <twig:ux:icon name="tabler:message" class="size-4" />
              Último mensaje el
              <twig:ux:icon name="tabler:clock" class="size-4" />
              {{ subforum.lastMessageAt|date("d/m/Y") }}
              por
              <twig:ux:icon name="tabler:user" class="size-4" />
              {{ subforum.lastMessageAuthorName }}
            </div>
          </twig:Ui:Item:Footer>
        </twig:Ui:Item>
      {% endfor %}
    </twig:Layout:Section>
  </twig:Layout:Article>
  <twig:Layout:Aside>
    <twig:Layout:Sidebar showRules />
  </twig:Layout:Aside>
{% endblock %}
