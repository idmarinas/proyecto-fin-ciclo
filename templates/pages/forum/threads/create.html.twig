{% extends 'base.html.twig' %}

{% block article %}
  <twig:Layout:Article>
    <twig:App:Breadcrumb :forum="forum.parent" :subforum="forum" page="Crear hilo" />

    <twig:Layout:Section>
      <twig:Ui:Item class="flex-col md:flex-row">
        <twig:Ui:Item:Media class="w-full md:w-auto">
          {{ parse_img(forum.image, forum.title, { class: 'w-full h-48 rounded-lg object-cover'}) }}
        </twig:Ui:Item:Media>
        <twig:Ui:Item:Content>
          <twig:Ui:Item:Title>
            <h1 class="text-2xl">
              <twig:ux:icon name="tabler:folder" class="size-8 inline-block" />
              {{ forum.title }}
            </h1>
          </twig:Ui:Item:Title>
          <twig:Ui:Item:Description>{{ forum.description }}</twig:Ui:Item:Description>
          <twig:Ui:Separator class="my-4" />
          <twig:Ui:Alert variant="{{ type == 'private' ? 'info' : 'warning' }}">
            {% if type == 'public' %}
              <twig:ux:icon name="tabler:alert-circle" class="size-6" />
            {% else %}
              <twig:ux:icon name="tabler:info-circle" class="size-6" />
            {% endif %}
            <twig:Ui:Alert:Title>Este será un hilo {{ type == 'private' ? 'Privado' : 'Público' }}</twig:Ui:Alert:Title>
            <twig:Ui:Alert:Description>
              {% if type == 'public' %}
                Este hilo será visible para todos los usuarios que visiten este subforo. Asegúrate de no incluir información sensible o privada en el título o contenido del hilo, ya que cualquier persona podrá verlo y responderlo.
              {% else %}
                Este hilo será privado y solo visible para ti y los moderadores del foro. No se mostrará en la lista de hilos del subforo, pero los moderadores podrán acceder a él para ayudarte con tu consulta. Asegúrate de incluir toda la información relevante para que puedan asistirte de la mejor manera posible.
              {% endif %}
            </twig:Ui:Alert:Description>
          </twig:Ui:Alert>
        </twig:Ui:Item:Content>
        <twig:Ui:Item:Footer>
          <div class="flex items-center gap-2 text-sm text-muted-foreground">
            <twig:ux:icon name="tabler:clock" class="w-4 h-4 text-primary" />
            Última actividad: {{ forum.lastMessageAt|date("d/m/Y") }}
          </div>
        </twig:Ui:Item:Footer>
      </twig:Ui:Item>
    </twig:Layout:Section>

    <twig:Ui:Separator />

    <twig:Layout:Section>
      {{ include('pages/forum/threads/create.form.html.twig') }}
    </twig:Layout:Section>
  </twig:Layout:Article>

  <twig:Layout:Aside>
    <twig:Layout:Sidebar showRules />
  </twig:Layout:Aside>
{% endblock %}
