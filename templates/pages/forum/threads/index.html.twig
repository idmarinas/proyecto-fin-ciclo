{# @var subforum \App\Entity\Forum #}
{# @var thread \App\Entity\Forum\Thread #}

{% extends 'base.html.twig' %}

{% block header_meta %}
  {{ knp_pagination_rel_links(pagination) }}
{% endblock %}

{% block article %}
  <twig:Layout:Article>
    <twig:Layout:Section>
      <twig:Ui:Item class="flex-col md:flex-row">
        <twig:Ui:Item:Media class="w-full md:w-auto">
          {{ parse_img(forum.image, forum.title, { class: 'w-full h-48 rounded-lg object-cover'}) }}
        </twig:Ui:Item:Media>
        <twig:Ui:Item:Content>
          <twig:Ui:Item:Title>
            <h1 class="text-2xl">
              <twig:ux:icon name="tabler:folder" class="size-8 inline-block" />
              {{ forum.title }}
            </h1>
          </twig:Ui:Item:Title>
          <twig:Ui:Item:Description>{{ forum.description }}</twig:Ui:Item:Description>

          <div class="grid grid-cols-2 md:grid-rows-2 md:grid-cols-1 gap-4 mt-2">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="flex items-center gap-2">
                <twig:ux:icon
                    name="{{ forum.totalMessages > 0 ? 'tabler:messages' : 'tabler:messages-off' }}"
                    class="text-blue-600 size-6"
                />
                <span>Hilos <twig:Ui:Badge
                      class="bg-blue-100 text-blue-600">{{ forum.totalThreads }}</twig:Ui:Badge></span>
              </div>
              <div class="flex items-center gap-2">
                <twig:ux:icon name="tabler:message" class="text-blue-600 size-6" />
                <span>Mensajes: <twig:Ui:Badge class="bg-blue-100 text-blue-600">{{ forum.totalMessages }}</twig:Ui:Badge></span>
              </div>
              <div class="flex items-center gap-2">
                <twig:ux:icon name="tabler:message-circle-x" class="text-red-600 size-6" />
                <span>Cerrados: <twig:Ui:Badge class="bg-red-100 text-red-600">{{ forum.threadsClosed }}</twig:Ui:Badge></span>
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="flex items-center gap-2">
                <twig:ux:icon name="tabler:message-circle-check" class="text-green-600 size-6" />
                <span>Resueltos: <twig:Ui:Badge class="bg-green-100 text-green-600">{{ forum.threadsResolved }}</twig:Ui:Badge></span>
              </div>
              <div class="flex items-center gap-2">
                <twig:ux:icon name="tabler:message-circle-exclamation" class="text-yellow-600 size-6" />
                <span>En progreso: <twig:Ui:Badge class="bg-yellow-100 text-yellow-600">{{ forum.threadsInProgress }}</twig:Ui:Badge></span>
              </div>
              <div class="flex items-center gap-2">
                <twig:ux:icon name="tabler:message-circle-question" class="text-gray-600 size-6" />
                <span>Sin respuesta: <twig:Ui:Badge class="bg-gray-100 text-gray-600">{{ forum.threadsOpen }}</twig:Ui:Badge></span>
              </div>
            </div>
          </div>
        </twig:Ui:Item:Content>
        <twig:Ui:Item:Footer>
          <div class="flex items-center gap-2 text-sm text-gray-600">
            <twig:ux:icon name="tabler:clock" class="w-4 h-4 text-blue-700" />
            Última actividad: {{ forum.lastMessageAt|date("d/m/Y") }}
          </div>

          <twig:Ui:ButtonGroup>
            {% if is_granted('create.thread.public', forum) %}
              <twig:Ui:Button
                  href="{{ path('app_forums_forum_thread_create', {
                    slug_forum: forum.parent.slug,
                    slug_subforum: forum.slug,
                    type: 'public'
                  }) }}"
                  as="a"
                  size="sm"
              >
                Crear hilo público
              </twig:Ui:Button>
            {% endif %}

            {% if is_granted('create.thread.private', forum) %}
              <twig:Ui:Button
                  href="{{ path('app_forums_forum_thread_create', {
                    slug_forum: forum.parent.slug,
                    slug_subforum: forum.slug,
                    type: 'private'
                  }) }}"
                  as="a" variant="secondary" size="sm"
              >Crear hilo privado
              </twig:Ui:Button>
            {% endif %}
          </twig:Ui:ButtonGroup>
        </twig:Ui:Item:Footer>
      </twig:Ui:Item>
    </twig:Layout:Section>

    <twig:Ui:Separator class="my-6" />

    <twig:Layout:Section class="space-y-6">
      {# Lista de hilos #}
      {% for thread in pagination %}
        <twig:Ui:Item
            variant="outline"
            as="a"
            href="{{ path('app_forums_forum_thread_view', {
              slug_forum: forum.parent.slug,
              slug_subforum: forum.slug,
              slug_thread: thread.slug
            }) }}"
        >
          <twig:Ui:Item:Header>
            <div class="flex items-center gap-3">
              {# Tipo de hilo #}
              <twig:App:Badge:IsPrivate :is_private="thread.private" />
              {# Tipo de usuario #}
              <twig:App:Badge:Role :author="thread.author" />
              {# Clasificación del problema #}
              <twig:App:Forum:Thread:Problem :thread="thread" />
            </div>
            <div class="flex items-center gap-3">
              <div class="flex items-center gap-1">
                {{ ux_icon(thread.messageCount > 0 ? 'tabler:message' : 'tabler:message-off', {class: 'size-6'}) }}
                {{ thread.messageCount }} respuestas
              </div>

              <twig:App:Forum:Thread:Status:Icon
                  :status="thread.status"
                  :replies="thread.messageCount"
                  class="size-6"
                  colorize text
              />
            </div>

          </twig:Ui:Item:Header>
          <twig:Ui:Item:Media>
            <twig:App:Forum:Thread:Status:Icon
                :status="thread.status"
                :replies="thread.messageCount"
                class="size-19"
                colorize
            />
          </twig:Ui:Item:Media>

          <twig:Ui:Item:Content class="flex-1 space-y-3">
            <twig:Ui:Item:Title><h3>{{ thread.title }}</h3></twig:Ui:Item:Title>
            <twig:Ui:Item:Description>
              {{ thread.description|raw }}
            </twig:Ui:Item:Description>
          </twig:Ui:Item:Content>

          <twig:Ui:Item:Footer class="flex items-center justify-between">
            <div class="flex gap-1 items-center">
              Creado por
              <twig:App:User:Avatar size="sm" :user="thread.author" />
              <em>{{ thread.author|u.truncate(10, '...') }}</em> el
              <twig:ux:icon name="tabler:clock" class="size-4" /> {{ thread.createdAt|date("d/m/Y H:i") }}
            </div>
            <div class="flex gap-1 items-center">
              {% if thread.lastMessage %}
                Última respuesta el
                <twig:ux:icon name="tabler:clock" class="size-4" />
                {{ thread.lastMessageAt|date("d/m/Y H:i") }} por
                <twig:App:User:Avatar size="sm" :user="thread.lastMessage.author" />
                <em>{{ thread.lastMessage.author|u.truncate(10, '...') }}</em>
              {% else %}
                Sin respuestas todavía
              {% endif %}
            </div>
          </twig:Ui:Item:Footer>
        </twig:Ui:Item>
      {% else %}
        <twig:Ui:Alert variant="warning" class="p-5">
          <twig:ux:icon name="tabler:message-off" class="size-12" />
          <twig:Ui:Alert:Title>No hay hilos en este subforo todavía.</twig:Ui:Alert:Title>
          <twig:Ui:Alert:Description>
            ¡Animáte y apúntate el tanto de haber creado el primer mensaje!
          </twig:Ui:Alert:Description>
        </twig:Ui:Alert>
      {% endfor %}
      {{ knp_pagination_render(pagination) }}
    </twig:Layout:Section>
  </twig:Layout:Article>
  <twig:Layout:Aside>{% include 'sidebar.html.twig' %}</twig:Layout:Aside>
{% endblock %}
