<twig:Turbo:Stream:Replace target="#container-notification-messages">
  <twig:Layout:NotificationMessages forced />
</twig:Turbo:Stream:Replace>

<twig:Turbo:Stream:Replace target="#container-flash-messages">
  <twig:Layout:FlashMessages forced />
</twig:Turbo:Stream:Replace>

{% if thread is defined and thread is not empty %}
  <twig:Turbo:Stream:Replace target="#thread-view-{{ thread.id }}">
    <twig:App:Forum:Thread:View:Question :thread="thread" />
  </twig:Turbo:Stream:Replace>
{% endif %}
