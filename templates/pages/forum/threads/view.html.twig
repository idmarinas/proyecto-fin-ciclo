{# @var reply \App\Entity\Forum\Message #}

{% extends 'base.html.twig' %}

{% block header_meta %}
  {{ knp_pagination_rel_links(pagination) }}
{% endblock %}

{% block article %}
  <twig:Layout:Article>
    <twig:App:Breadcrumb :forum="thread.forum.parent" :subforum="thread.forum" :page="thread" />

    <twig:Layout:Section class="pb-0">
      <twig:App:Forum:Thread:View:Question :thread="thread" />
    </twig:Layout:Section>

    <twig:Ui:Separator class="mb-6" />

    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <div class="md:col-span-3 space-y-6">
        <twig:Turbo:Frame id="thread-replies-frame">
          <twig:Layout:Section class="space-y-6">
            {% for reply in pagination %}
              <twig:App:Forum:Thread:View:InLineEditMessage :reply="reply" />
            {% else %}
              <twig:Ui:Card variant="full" class="p-6 border border-warning-border bg-warning/20 space-y-2">
                <twig:Ui:Card:Header>
                  <twig:Ui:Card:Title class="text-warning-foreground">
                    {{ ux_icon('tabler:help-circle', {class: 'size-7 inline'}) }} Este hilo aún no tiene respuestas
                  </twig:Ui:Card:Title>
                </twig:Ui:Card:Header>
                <twig:Ui:Card:Content class="text-warning-foreground">
                  Si conoces la solución o puedes aportar alguna idea, tu ayuda será muy apreciada por la comunidad.
                </twig:Ui:Card:Content>
              </twig:Ui:Card>
            {% endfor %}

            {{ knp_pagination_render(pagination) }}
          </twig:Layout:Section>
        </twig:Turbo:Frame>

        {#        Mirar para ponerlo usando turbo, y que no recargue la página completa #}
        {% if workflow_can(thread, 'public_reply') or workflow_can(thread, 'customer_reply') or workflow_can(thread, 'staff_reply') %}
          <twig:Turbo:Frame id="thread-reply-form-frame">
            <twig:Ui:Separator class="mb-10" />
            <twig:Layout:Section id="responder">{{ form(form, {attr: {'data-turbo': 'false'}}) }}</twig:Layout:Section>
          </twig:Turbo:Frame>
        {% endif %}
      </div>
      <twig:Layout:Aside>
        <twig:Layout:Sidebar :forum="thread.forum" />
      </twig:Layout:Aside>
    </div>
  </twig:Layout:Article>
{% endblock %}
