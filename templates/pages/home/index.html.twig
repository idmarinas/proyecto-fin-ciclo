{% extends 'base.html.twig' %}

{% block article %}

  <twig:Layout:Article>
    <twig:Layout:Section class="not-prose">
      <twig:Ui:Hero orientation="horizontal" class="not-prose">
        <twig:Ui:Hero:Content>
          <twig:Ui:Hero:Badge>{{ app_title }}</twig:Ui:Hero:Badge>
          <twig:Ui:Hero:Heading>Tecnología clara, soporte confiable.</twig:Ui:Hero:Heading>
          <twig:Ui:Hero:Description>
            En Lúmina Servicios Tecnológicos te ayudamos a iluminar tu camino digital con soluciones modernas, soporte
            experto y una comunidad activa.
          </twig:Ui:Hero:Description>
          <twig:Ui:Hero:Actions>
            <twig:Ui:Button size="lg" as="a" href="{{ path('app_user_register') }}">Crear cuenta</twig:Ui:Button>
            <twig:Ui:Button size="lg" as="a" href="{{ path('app_forums_index') }}" variant="outline">
              Acceder al foro
            </twig:Ui:Button>
          </twig:Ui:Hero:Actions>
        </twig:Ui:Hero:Content>
        <twig:Ui:Hero:Media>
          <div class="relative size-100 rounded-2xl overflow-hidden flex items-center justify-center
                      bg-gradient-to-br from-primary via-primary/80 to-secondary
                      shadow-2xl shadow-primary/40 ring-1 ring-primary/20">
            {# Patrón de puntos decorativo #}
            <div class="absolute inset-0 opacity-10"
                 style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 20px 20px;">
            </div>
            {# Círculo de brillo detrás del icono #}
            <div class="absolute size-60 rounded-full bg-white/10 blur-2xl"></div>
            {# Icono principal #}
            <twig:ux:icon name="tabler:bulb" class="relative size-48 text-primary-foreground drop-shadow-xl" />
            {# Iconos flotantes decorativos #}
            <twig:ux:icon name="tabler:code" class="absolute top-8 left-8 size-8 text-primary-foreground/50 rotate-[-12deg]" />
            <twig:ux:icon name="tabler:shield-check" class="absolute bottom-10 right-10 size-7 text-primary-foreground/50 rotate-12" />
            <twig:ux:icon name="tabler:rocket" class="absolute top-12 right-12 size-6 text-primary-foreground/40" />
          </div>
        </twig:Ui:Hero:Media>
      </twig:Ui:Hero>
    </twig:Layout:Section>

    <twig:Layout:Section class="pt-4">
      <h3 class="text-center text-2xl font-semibold text-foreground">Nuestros Servicios</h3>

      <div class="mt-12 grid md:grid-cols-3 gap-10 not-prose">
        <twig:Ui:Card class="group hover:shadow-md hover:-translate-y-1 transition-all duration-200">
          <twig:Ui:Card:Header class="text-center">
            <div class="mx-auto mb-4 flex size-16 items-center justify-center rounded-xl
                        bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-foreground
                        transition-colors duration-200">
              <twig:ux:icon name="tabler:device-desktop-code" class="size-8" />
            </div>
            <twig:Ui:Card:Title>Desarrollo Digital</twig:Ui:Card:Title>
          </twig:Ui:Card:Header>
          <twig:Ui:Card:Content class="text-center text-muted-foreground">
            Creamos soluciones digitales adaptadas a tus necesidades: plataformas, herramientas y sistemas modernos.
          </twig:Ui:Card:Content>
        </twig:Ui:Card>

        <twig:Ui:Card class="group hover:shadow-md hover:-translate-y-1 transition-all duration-200">
          <twig:Ui:Card:Header class="text-center">
            <div class="mx-auto mb-4 flex size-16 items-center justify-center rounded-xl
                        bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-foreground
                        transition-colors duration-200">
              <twig:ux:icon name="tabler:tools" class="size-8" />
            </div>
            <twig:Ui:Card:Title>Soporte Técnico</twig:Ui:Card:Title>
          </twig:Ui:Card:Header>
          <twig:Ui:Card:Content class="text-center text-muted-foreground">
            Asistencia experta, resolución de incidencias y acompañamiento técnico en cada paso.
          </twig:Ui:Card:Content>
        </twig:Ui:Card>

        <twig:Ui:Card class="group hover:shadow-md hover:-translate-y-1 transition-all duration-200">
          <twig:Ui:Card:Header class="text-center">
            <div class="mx-auto mb-4 flex size-16 items-center justify-center rounded-xl
                        bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-foreground
                        transition-colors duration-200">
              <twig:ux:icon name="tabler:chart-bar" class="size-8" />
            </div>
            <twig:Ui:Card:Title>Consultoría Tecnológica</twig:Ui:Card:Title>
          </twig:Ui:Card:Header>
          <twig:Ui:Card:Content class="text-center text-muted-foreground">
            Auditorías, planificación estratégica y optimización de procesos para mejorar tu entorno digital.
          </twig:Ui:Card:Content>
        </twig:Ui:Card>
      </div>
    </twig:Layout:Section>

    <!-- FORO -->
    <twig:Layout:Section>
      <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h3 class="text-2xl font-semibold text-foreground">Foro de Soporte y Ayuda</h3>
          <p class="mt-4 text-muted-foreground">
            Únete a la comunidad de Lúmina: comparte dudas, encuentra soluciones y recibe ayuda del equipo técnico y
            otros usuarios.
          </p>

          <ul class="mt-6 space-y-3 not-prose">
            <li class="flex items-start gap-2">
              <twig:ux:icon name="tabler:circle-check" class="size-6 text-success-foreground" />
              Respuestas rápidas y claras
            </li>
            <li class="flex items-start gap-2">
              <twig:ux:icon name="tabler:circle-check" class="size-6 text-success-foreground" />
              Comunidad activa y colaborativa
            </li>
            <li class="flex items-start gap-2">
              <twig:ux:icon name="tabler:circle-check" class="size-6 text-success-foreground" />
              Soporte técnico especializado
            </li>
          </ul>

          <twig:Ui:Button size="lg" as="a" href="{{ path('app_forums_index') }}" class="mt-8 not-prose">
            Entrar al foro
          </twig:Ui:Button>
        </div>

        <div class="flex justify-center not-prose">
          <div class="relative w-full h-80 md:w-80 rounded-2xl overflow-hidden flex items-center justify-center
                      bg-gradient-to-br from-primary/90 to-primary shadow-xl shadow-primary/30
                      ring-1 ring-primary/20">
            <div class="absolute inset-0 opacity-10"
                 style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 18px 18px;">
            </div>
            <div class="absolute size-48 rounded-full bg-white/10 blur-2xl"></div>
            <twig:ux:icon name="tabler:messages" class="relative size-36 text-primary-foreground drop-shadow-lg" />
            <twig:ux:icon name="tabler:user-check" class="absolute bottom-8 left-8 size-7 text-primary-foreground/50" />
            <twig:ux:icon name="tabler:circle-check" class="absolute top-8 right-8 size-6 text-primary-foreground/50" />
          </div>
        </div>
      </div>
    </twig:Layout:Section>
  </twig:Layout:Article>
{% endblock %}
