{% extends 'base.html.twig' %}

{% block article %}
  <twig:Ui:Card class="mx-auto">
    <twig:Ui:Card:Header>
      <twig:Ui:Card:Title>Editar perfil</twig:Ui:Card:Title>
    </twig:Ui:Card:Header>
    <twig:Ui:Card:Content>
      <twig:Turbo:Frame id="form-frame-{{ form.vars.id }}">
        {{ form(form) }}
      </twig:Turbo:Frame>
    </twig:Ui:Card:Content>
  </twig:Ui:Card>
{% endblock %}
