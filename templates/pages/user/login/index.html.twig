{% extends 'base.html.twig' %}

{% block main %}
  <div class="flex min-h-full flex-col justify-center items-center p-6 lg:px-8">
    <twig:Ui:Card variant="responsive">
      <twig:Ui:Card:Header>
        <img src="{{ asset('images/public_thread.webp') }}" alt="{{ app_title }}" class="mx-auto h-15 w-auto" />
        <twig:Ui:Card:Title>
          Conéctate a tu cuenta.
        </twig:Ui:Card:Title>
      </twig:Ui:Card:Header>
      <twig:Ui:Card:Content>
        <twig:Layout:FlashMessages />
        {{ include('pages/user/login/partials/_form.html.twig') }}
      </twig:Ui:Card:Content>
      <twig:Ui:Card:Footer class="flex-col justify-center">
        <div class="text-sm text-gray-600 dark:text-gray-300">
          ¿No tienes cuenta?
          <twig:Ui:Button as="a" variant="link" href="{{ path('app_user_register') }}">Crea una cuenta</twig:Ui:Button>
        </div>
        <div class="text-sm text-gray-600 dark:text-gray-300">
          ¿Olvidaste la contraseña?
          <twig:Ui:Button as="a" variant="link" href="{{ path('app_user_forgot_password_request') }}">
            Restablece la contraseña
          </twig:Ui:Button>
        </div>
      </twig:Ui:Card:Footer>
    </twig:Ui:Card>
  </div>
{% endblock %}
