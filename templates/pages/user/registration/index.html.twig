{% extends 'base.html.twig' %}

{% block main %}
  <div class="flex min-h-full flex-col justify-center items-center p-6 lg:px-8">
    <twig:Layout:FlashMessages />

    <twig:Ui:Card variant="responsive">
      <twig:Ui:Card:Header>
        <img src="{{ asset('images/public_thread.webp') }}" alt="{{ app_title }}" class="mx-auto h-15 w-auto" />
        <twig:Ui:Card:Title>Crea una cuenta</twig:Ui:Card:Title>
      </twig:Ui:Card:Header>

      <twig:Ui:Card:Content>
        <twig:Turbo:Frame :id="'frame_' ~ form.vars.id">
          {{ form(form) }}
        </twig:Turbo:Frame>
      </twig:Ui:Card:Content>
      <twig:Ui:Card:Footer class="justify-center">
        <div class="text-sm text-muted-foreground">
          ¿Ya tienes cuenta?
          <twig:Ui:Button as="a" variant="link" href="{{ path('app_user_login') }}">Iniciar sesión</twig:Ui:Button>
        </div>
      </twig:Ui:Card:Footer>
    </twig:Ui:Card>
  </div>
{% endblock %}
