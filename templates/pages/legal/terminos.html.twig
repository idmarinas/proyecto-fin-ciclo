{% extends 'base.html.twig' %}

{% block article %}
  <twig:Layout:Article>
    <twig:Layout:Section class="prose prose-slate dark:prose-invert mx-auto">

      <div class="flex items-center gap-3 mb-2">
        <h1>
          <twig:ux:icon name="tabler:file-description" class="size-8 text-primary inline" />
          Términos y Condiciones de Uso
