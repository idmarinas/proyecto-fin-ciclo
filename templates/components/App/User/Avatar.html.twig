{% component 'Ui:Avatar' with attributes %}
  {% block content %}
    {% if app.user.avatar is not empty %}
      {{ component('Ui:Avatar:Image', {src: app.user.avatar|avatar_url }) }}
    {% else %}
      {% component 'Ui:Avatar:Text' with {class: 'bg-primary text-primary-foreground'} %}
        {% block content app.user.userIdentifier[:2]|upper %}
      {% endcomponent %}
    {% endif %}
  {% endblock %}
{% endcomponent %}
