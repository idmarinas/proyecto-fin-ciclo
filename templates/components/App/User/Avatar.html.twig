{# @var user \App\Entity\User\User|null #}

{% props user, tooltip = false %}

{# ── Usuario borrado: avatar genérico (deletedAt no nulo) ── #}
{% set is_deleted = user is null or user.deletedAt is not null %}

{% if is_deleted %}
  <twig:Ui:Avatar {{ ...attributes }}>
    <twig:Ui:Avatar:Fallback class="bg-amber-100 text-amber-600 border border-amber-300">
      {{ ux_icon('tabler:user-x', {class: 'size-4'}) }}
    </twig:Ui:Avatar:Fallback>
  </twig:Ui:Avatar>
{% elseif tooltip %}
  <twig:Ui:Tooltip id="user-avatar-{{ user.id }}">
    <twig:Ui:Tooltip:Trigger>
      <twig:Ui:Avatar {{ ...trigger_attrs, ...attributes }}>
        <twig:Ui:Avatar:Image src="{{ user.avatar|avatar_url }}" alt="{{ user.userIdentifier }}" />
        <twig:Ui:Avatar:Fallback>{{ user.userIdentifier[:2]|upper }}</twig:Ui:Avatar:Fallback>
      </twig:Ui:Avatar>
    </twig:Ui:Tooltip:Trigger>
    <twig:Ui:Tooltip:Content>{{ user.userIdentifier }}</twig:Ui:Tooltip:Content>
  </twig:Ui:Tooltip>
{% else %}
  <twig:Ui:Avatar {{ ...attributes }}>
    <twig:Ui:Avatar:Image src="{{ user.avatar|avatar_url }}" alt="{{ user.userIdentifier }}" />
    <twig:Ui:Avatar:Fallback>{{ user.userIdentifier[:2]|upper }}</twig:Ui:Avatar:Fallback>
  </twig:Ui:Avatar>
{% endif %}
