{# @var author \App\Entity\User\User #}

{% props author %}

{% set text = 'Usuario' %}

{% if is_granted_for_user(author, 'ROLE_SUPER_ADMIN') %}
  {% set text = 'Super Admin' %}
{% elseif is_granted_for_user(author, 'ROLE_ADMIN' ) %}
  {% set text = 'Admin' %}
{% elseif is_granted_for_user(author, 'ROLE_SUPPORT' ) %}
  {% set text = 'Soporte' %}
{% elseif is_granted_for_user(author, 'ROLE_CLIENT' ) %}
  {% set text = 'Cliente' %}
{% endif %}

{% set class = 'px-3 py-1 text-xs rounded ' ~ html_classes({
  'bg-danger/20 text-danger-foreground':   'Super Admin' === text,
  'bg-info/20 text-info-foreground':       'Admin' === text,
  'bg-warning/20 text-warning-foreground': 'Soporte' === text,
  'bg-success/20 text-success-foreground': 'Cliente' === text,
  'bg-muted text-muted-foreground':        'Usuario' === text
}) ~ ' ' ~ attributes.render('class') %}

{% component 'Ui:Badge' with {...attributes, class} %}
  {% block content text %}
{% endcomponent %}
