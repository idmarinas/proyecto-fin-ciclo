{% props days %}

{% set text = days < 2 ? 'Activo' : days < 7 ? 'Moderado' : 'Tranquilo' %}

<twig:Ui:Badge
    class="{{ html_classes({
      'bg-success/20 text-success-foreground': 'Activo' === text,
      'bg-warning/20 text-warning-foreground': 'Moderado' === text,
      'bg-muted text-muted-foreground':        'Tranquilo' === text
    }) }}"
>{{ text }}</twig:Ui:Badge>
