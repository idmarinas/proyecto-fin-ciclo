{%- props is_private -%}

{% set text = true === is_private ? 'Privado' : 'Público' %}

{% set class = 'px-3 py-1 text-xs rounded ' ~ html_classes({
  'bg-gray-800 text-gray-100': 'Privado' === text,
  'bg-blue-100 text-blue-700': 'Público' === text
}) ~ ' ' ~ attributes.render('class') %}

<twig:Ui:Button variant="ghost" size="sm">
  <img
      src="{{ asset('Público' == text ? 'images/public_thread.webp' : 'images/private_thread.webp') }}"
      alt="{{ text }}"
      class="size-5"
  />
  {{ text }}
</twig:Ui:Button>
