{%- props is_private -%}

{% set text = true === is_private ? 'Privado' : 'Público' %}

{% set class = 'px-3 py-1 text-xs rounded ' ~ html_classes({
  'bg-gray-800 text-gray-100': 'Privado' === text,
  'bg-blue-100 text-blue-700': 'Público' === text
}) ~ ' ' ~ attributes.render('class') %}

<twig:Ui:Tooltip id="badge-tooltip-private-public">
  <twig:Ui:Tooltip:Trigger>
    <twig:Ui:Button {{ ...trigger_attrs }} variant="ghost" size="icon">
      <img
          src="{{ asset('Público' ? 'images/public_thread.webp' : 'images/private_thread.webp') }}"
          alt="{{ text }}"
          class="size-8"
      />
    </twig:Ui:Button>
  </twig:Ui:Tooltip:Trigger>
  <twig:Ui:Tooltip:Content>{{ text }}</twig:Ui:Tooltip:Content>
</twig:Ui:Tooltip>
