<twig:Ui:Card class="border bg-accent rounded-xl space-y-3">
  <twig:Ui:Card:Header>
    <twig:Ui:Card:Title>
      <h3 class="text-accent-foreground">
        {{ ux_icon('tabler:quote', {class: 'inline-block w-5 h-5 mr-1 text-primary'}) }}
        Frase del día
      </h3>
    </twig:Ui:Card:Title>
  </twig:Ui:Card:Header>

  <twig:Ui:Card:Content>
    <blockquote class="text-sm text-foreground italic leading-relaxed border-l-2 border-primary pl-3">
      &ldquo;{{ quote.text }}&rdquo;
    </blockquote>
    <p class="text-xs text-muted-foreground text-right mt-2">&mdash; {{ quote.author }}</p>
  </twig:Ui:Card:Content>
</twig:Ui:Card>
