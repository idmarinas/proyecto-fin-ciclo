{# @var reply \App\Entity\Forum\Message #}

{% set thread_deleted  = reply.thread.deletedAt is not null %}
{% set message_deleted = reply.deletedAt is not null %}
{% set author_deleted  = reply.author is not null and reply.author.deletedAt is not null %}

{#
Reglas de visibilidad:
- Mensaje borrado individualmente  → solo admins/superadmins lo ven (deletedAt en Message)
- Hilo borrado (todos sus mensajes) → solo admins/superadmins los ven (deletedAt en Thread)
- Autor borrado                    → visible para todos, con aspecto diferenciado (deletedAt en User)
#}
  {# ── Clases del contenedor según estado ── #}
  {% if thread_deleted %}
    {# Borrado por hilo: rojo tenue — diferente al de mensaje borrado individualmente #}
    {% set wrapper_class = 'border-error-border bg-error/20 opacity-65 rounded-t-none' %}
  {% elseif message_deleted %}
    {# Borrado individualmente: gris neutro — distinto al de hilo borrado #}
    {% set wrapper_class = 'border-dashed border-notice-border bg-notice/40 opacity-80 rounded-t-none' %}
  {% else %}
    {% set wrapper_class = '' %}
  {% endif %}

  {# ── Banner: hilo borrado ── #}
  {% if thread_deleted %}
    <div class="relative mb-0 w-full flex items-center gap-2 rounded-t bg-danger px-3 py-1.5 text-xs font-semibold text-danger-foreground">
      <twig:ux:icon name="tabler:folder-x" class="size-3.5 shrink-0" />
      Mensaje perteneciente a un hilo borrado
      {% if reply.thread.deletedAt %}
        <span class="ml-auto font-normal text-danger-foreground/70">{{ reply.thread.deletedAt|date("d/m/Y H:i") }}</span>
      {% endif %}
    </div>
  {% endif %}
  {# ── Banner: mensaje borrado individualmente ── diferente al del hilo ── #}
  {% if not thread_deleted and message_deleted %}
    <div class="col-span-full w-full flex items-center gap-2 rounded-t bg-notice px-3 py-1.5 text-xs font-semibold text-notice-foreground">
      <twig:ux:icon name="tabler:message-x" class="size-3.5 shrink-0" />
      Mensaje borrado
      {% if reply.deletedAt %}
        <span class="ml-auto font-normal text-notice-foreground/70">{{ reply.deletedAt|date("d/m/Y H:i") }}</span>
      {% endif %}
    </div>
  {% endif %}
<twig:Ui:Item
    variant="outline"
    class="items-stretch last:mb-0 {{ is_resolver }} {{ wrapper_class }}"
    {{ ...attributes }}
    :id="item_id"
>
  {% if is_editing and not thread_deleted and not message_deleted %}
    {# ─── Modo edición (solo disponible en mensajes activos) ──────────── #}
    <twig:Ui:Item:Header>
      <div class="flex items-center gap-2">
        <twig:App:User:Avatar :user="reply.author" />
        {{ reply.createdBy }}
      </div>
      <twig:App:Badge:Role :author="reply.author" class="px-2 py-1" />
    </twig:Ui:Item:Header>
    <twig:Ui:Item:Content class="justify-between">
      {{ form_start(form, {
        attr: {
          class: 'w-full',
          'data-action': 'live#action:prevent',
          'data-live-action-param': 'save'
        }
      }) }}
      <twig:Ui:Field:Set>
        {{ form_rest(form) }}
      </twig:Ui:Field:Set>
      {{ form_end(form) }}
    </twig:Ui:Item:Content>
    <twig:Ui:Item:Footer class="justify-end">
      <div class="flex items-center gap-2 text-sm">
        {{ ux_icon('tabler:clock', {class: 'size-4'}) }} {{ reply.createdAt|date("d/m/Y H:i") }}
      </div>
    </twig:Ui:Item:Footer>

  {% else %}
    {# ─── Modo lectura ────────────────────────────────────────────────── #}
    <twig:Ui:Item:Header>
      <div class="flex items-center gap-2">
        {# Avatar — el componente gestiona el usuario borrado internamente #}
        <twig:App:User:Avatar :user="reply.author" />
        {% if author_deleted %}
          <span class="italic text-warning-foreground text-sm">[Usuario borrado]</span>
        {% else %}
          {{ reply.createdBy }}
        {% endif %}
      </div>
      <div class="flex items-center gap-2">
        {% if author_deleted %}
          <span class="inline-flex items-center gap-1 rounded-full bg-warning/30 border border-warning-border px-2.5 py-0.5 text-xs font-medium text-warning-foreground">
              <twig:ux:icon name="tabler:user-x" class="size-3" />
              Autor borrado
            </span>
        {% else %}
          <twig:App:Badge:Role :author="reply.author" class="px-2 py-1" />
        {% endif %}
      </div>
    </twig:Ui:Item:Header>

    <twig:Ui:Item:Content class="justify-between">
      {% if message_deleted %}
        {# Mensaje borrado individualmente: ocultar contenido #}
        <div class="flex items-center gap-2 text-muted-foreground italic text-sm py-2">
          <twig:ux:icon name="tabler:message-x" class="size-5 shrink-0" />
          <span>Este mensaje ha sido borrado y su contenido ya no está disponible.</span>
        </div>
      {% elseif thread_deleted %}
        {# Hilo borrado: mostrar contenido atenuado, sin interacción #}
        <div class="prose prose-slate max-w-none opacity-50 select-none pointer-events-none">
          {{ reply.content|raw }}
        </div>
      {% else %}
        <div class="prose prose-slate max-w-none">
          {{ reply.content|raw }}
        </div>
      {% endif %}
    </twig:Ui:Item:Content>

    <twig:Ui:Item:Footer>
      {# Acciones: solo en mensajes activos (ni hilo borrado ni mensaje borrado) #}
      {% if not thread_deleted and not message_deleted %}
        <twig:Ui:ButtonGroup>
          {% if is_granted('message.edit', reply) %}
            <twig:Ui:Button
                data-action="live#action"
                data-live-action-param="activateEditing"
                size="xs"
                class="bg-warning hover:bg-warning/70 text-warning-foreground border-warning"
            >
              {{ ux_icon('tabler:pencil') }} Editar
            </twig:Ui:Button>
          {% endif %}
          {% if is_granted('message.delete', reply) %}
            <twig:Ui:Button
                as="a"
                size="xs"
                href="{{ path('app_forums_forum_thread_message_delete', {id: reply.id, type: 'delete'}) }}"
                class="bg-error text-error-foreground hover:bg-error/70 border-error"
                data-turbo-stream="true"
            >
              {{ ux_icon('tabler:trash') }} Borrar
            </twig:Ui:Button>
          {% endif %}
        </twig:Ui:ButtonGroup>
        <div class="flex-1"></div>
        {% if workflow_can(reply.thread, 'resolve') %}
          <twig:Ui:Button
              as="a"
              size="xs"
              class="bg-success text-success-foreground hover:bg-success/70"
              href="{{ path('app_forums_forum_thread_resolve', {
                slug_forum: reply.thread.forum.slug,
                slug_subforum: reply.thread.forum.parent.slug,
                id: reply.thread.id,
                id_message: reply.id
              }) }}"
              data-turbo-stream="true"
          >
            {{ ux_icon('tabler:message-check') }} Marcar como solución
          </twig:Ui:Button>
        {% endif %}
        {% if is_granted('message.remove', reply) %}
          <twig:Ui:Button
              as="a"
              size="xs"
              href="{{ path('app_forums_forum_thread_message_delete', {id: reply.id, type: 'remove'}) }}"
              class="bg-danger text-danger-foreground hover:bg-danger/70 border-danger mr-4"
              data-turbo-stream="true"
          >
            {{ ux_icon('tabler:trash') }} Eliminar
          </twig:Ui:Button>
        {% endif %}
      {% endif %}

      <div class="flex items-center gap-2 text-sm ml-auto
          {{ thread_deleted ? 'text-danger-foreground' : (message_deleted ? 'text-muted-foreground' : '') }}">
        {{ ux_icon('tabler:clock', {class: 'size-4'}) }} {{ reply.createdAt|date("d/m/Y H:i") }}
      </div>
    </twig:Ui:Item:Footer>
  {% endif %}
</twig:Ui:Item>
