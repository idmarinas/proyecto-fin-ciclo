<twig:Ui:Item
    variant="outline"
    class="items-stretch last:mb-0 {{ is_resolver }}"
    {{ ...attributes }}
    :id="item_id"
>
  {% if is_editing %}
    <twig:Ui:Item:Header>
      <div class="flex items-center gap-2">
        <twig:App:User:Avatar :user="reply.author" />
        {{ reply.createdBy }}
      </div>
      {# Tipo de usuario #}
      <twig:App:Badge:Role :author="reply.author" class="px-2 py-1" />
    </twig:Ui:Item:Header>
    <twig:Ui:Item:Content class="justify-between">
      {{ form_start(form, {
        attr: {
          class: 'w-full',
          'data-action': 'live#action:prevent',
          'data-live-action-param': 'save'
        }
      }) }}
      <twig:Ui:Field:Set>
        {{ form_rest(form) }}
      </twig:Ui:Field:Set>
      {{ form_end(form) }}
    </twig:Ui:Item:Content>

    <twig:Ui:Item:Footer class="justify-end">
      <div class="flex items-center gap-2">
        {{ ux_icon('tabler:clock', {class: 'size-4'}) }} {{ reply.createdAt|date("d/m/Y H:i") }}
      </div>
    </twig:Ui:Item:Footer>
  {% else %}
    <twig:Ui:Item:Header>
      <div class="flex items-center gap-2">
        <twig:App:User:Avatar :user="reply.author" />
        {{ reply.createdBy }}
      </div>
      {# Tipo de usuario #}
      <twig:App:Badge:Role :author="reply.author" class="px-2 py-1" />
    </twig:Ui:Item:Header>
    <twig:Ui:Item:Content class="justify-between">
      <div class="prose prose-slate max-w-none">
        {{ reply.content|raw }}
      </div>
    </twig:Ui:Item:Content>

    <twig:Ui:Item:Footer>
      <twig:Ui:ButtonGroup>
        {% if is_granted('ROLE_USER', reply) and app.user.id != reply.author.id %}
          <twig:Ui:Button size="xs" variant="destructive">
            {{ ux_icon('tabler:flag', {class: 'size-4'}) }} Reportar
          </twig:Ui:Button>
        {% endif %}
        {% if is_granted('message.edit', reply) %}
          <twig:Ui:Button
              data-action="live#action"
              data-live-action-param="activateEditing"
              size="xs"
              class="bg-warning hover:bg-warning/70 text-warning-foreground border-warning"
          >
            {{ ux_icon('tabler:pencil') }} Editar
          </twig:Ui:Button>
        {% endif %}
        {% if is_granted('message.delete', reply) %}
          <twig:Ui:Button
              as="a"
              size="xs"
              href="{{ path('app_forums_forum_thread_message_delete', {id: reply.id, type: 'delete'}) }}"
              class="bg-error text-error-foreground hover:bg-error/70 border-error"
              data-turbo-stream="true"
          >
            {{ ux_icon('tabler:trash') }} Borrar
          </twig:Ui:Button>
        {% endif %}

      </twig:Ui:ButtonGroup>
      {% if is_granted('message.remove', reply) %}
        <div class="flex-1"></div>
        <twig:Ui:Button
            as="a"
            size="xs"
            href="{{ path('app_forums_forum_thread_message_delete', {id: reply.id, type: 'remove'}) }}"
            class="bg-danger text-danger-foreground hover:bg-danger/70 border-danger mr-4"
            data-turbo-stream="true"
        >
          {{ ux_icon('tabler:trash') }} Eliminar
        </twig:Ui:Button>
      {% endif %}
      <div class="flex items-center gap-2">
        {{ ux_icon('tabler:clock', {class: 'size-4'}) }} {{ reply.createdAt|date("d/m/Y H:i") }}
      </div>
    </twig:Ui:Item:Footer>
  {% endif %}
</twig:Ui:Item>
