{# @var thread \App\Entity\Forum\Thread #}

{% props thread %}

{% if thread.isIncident %}
  <twig:Ui:Tooltip id="incident-tooltip">
    <twig:Ui:Tooltip:Trigger>
      <twig:Ui:Badge {{ ...trigger_attrs }}
          class="rounded-full p-1 bg-warning text-warning-foreground"
          aria-label="Incidente"
      >
        {{ ux_icon('tabler:alert-triangle', {class: 'size-4!'}) }}
      </twig:Ui:Badge>
    </twig:Ui:Tooltip:Trigger>
    <twig:Ui:Tooltip:Content>Incidente</twig:Ui:Tooltip:Content>
  </twig:Ui:Tooltip>
{% endif %}

{% if thread.isCritical %}
  <twig:Ui:Tooltip id="critical-tooltip">
    <twig:Ui:Tooltip:Trigger>
      <twig:Ui:Badge {{ ...trigger_attrs }} class="rounded-full p-1 bg-danger text-danger-foreground" aria-label="Crítico">
        {{ ux_icon('tabler:flame', {class: 'size-4!'}) }}
      </twig:Ui:Badge>
    </twig:Ui:Tooltip:Trigger>
    <twig:Ui:Tooltip:Content>Crítico</twig:Ui:Tooltip:Content>
  </twig:Ui:Tooltip>
{% endif %}

{% if thread.affectsBusiness %}
  <twig:Ui:Tooltip id="business-tooltip">
    <twig:Ui:Tooltip:Trigger>
      <twig:Ui:Badge {{ ...trigger_attrs }} class="rounded-full p-1 bg-info text-info-foreground" aria-label="Afecta a mi negocio">
        {{ ux_icon('tabler:building', {class: 'size-4!'}) }}
      </twig:Ui:Badge>
    </twig:Ui:Tooltip:Trigger>
    <twig:Ui:Tooltip:Content>Afecta a mi negocio</twig:Ui:Tooltip:Content>
  </twig:Ui:Tooltip>
{% endif %}
