{% props status, replies, colorize = false, text = false %}

{% set statusEnum = enum('App\\Enums\\ThreadStatusEnum') %}

{% set icon_name = status.value %}

{% if statusEnum.OPEN == status and replies > 0 %}
  {% set icon_name = 'progress' %}
{% endif %}

{% set color = '' %}

{% if colorize %}
  {% set color = html_classes({
    'text-muted-foreground ': icon_name == 'open',
    'text-warning-foreground ': icon_name == 'progress',
    'text-info-foreground ': icon_name == 'waiting_customer',
    'text-info-foreground ': icon_name == 'waiting_support',
    'text-success-foreground ': icon_name == 'resolved',
    'text-danger-foreground ': icon_name == 'closed'
  }) %}
{% endif %}

{{ ux_icon('thread:' ~ icon_name, {...attributes, class: ('size-7 ' ~ color ~ attributes.render('class'))|tailwind_merge}) }}
{% if text %}
  <span class="{{ color }}">
    {% if icon_name == 'progress' %}
      En progreso
    {% elseif icon_name == 'resolved' %}
      Resuelto
    {% elseif icon_name == 'open' %}
      Esperando ayuda
    {% elseif icon_name == 'closed' %}
      Cerrado
    {% elseif icon_name == 'waiting_support' %}
      Esperando Soporte
    {% elseif icon_name == 'waiting_customer' %}
      Esperando Usuario
    {% endif %}
  </span>
{% endif %}
