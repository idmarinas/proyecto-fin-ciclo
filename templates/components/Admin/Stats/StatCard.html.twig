{#
  Tarjeta de estadística para el dashboard de administración (Bootstrap 5).

  @prop string      label   Etiqueta descriptiva de la estadística.
  @prop int|string  value   Valor principal a mostrar.
  @prop string      icon    Nombre del icono Tabler (ej. "tabler:message").
  @prop string      color   Color semántico Bootstrap: 'warning'|'info'|'success'|'danger'|'primary'|'secondary'.
  @prop string|null sub     Texto secundario opcional.
  @prop string      layout  'vertical' (por defecto) | 'horizontal' (icono a la izquierda).
#}
{%- props label = '', value = 0, icon = 'tabler:chart-bar', color = 'primary', sub = null, layout = 'vertical' -%}

<div class="card h-100 border-0 shadow-sm"
     style="border-left: 4px solid var(--bs-{{ color }}) !important; background: color-mix(in srgb, var(--bs-{{ color }}) 8%, var(--bs-body-bg));">

    {% if layout == 'horizontal' %}
        <div class="card-body d-flex align-items-center gap-3 p-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:3rem;height:3rem;background:color-mix(in srgb, var(--bs-{{ color }}) 15%, transparent);">
                <span class="text-{{ color }}">
                    <twig:ux:icon name="{{ icon }}" style="width:1.5rem;height:1.5rem;" />
                </span>
            </div>
            <div class="min-w-0">
                <div class="text-muted small fw-medium">{{ label }}</div>
                <div class="fs-3 fw-bold lh-1 mt-1 text-{{ color }}">{{ value }}</div>
                {% if sub is not null %}
                    <div class="text-muted small mt-1">{{ sub }}</div>
                {% endif %}
            </div>
        </div>
    {% else %}
        <div class="card-body d-flex flex-column gap-2 p-3">
            <div class="d-flex align-items-center justify-content-between">
                <span class="text-muted small fw-medium">{{ label }}</span>
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:2.25rem;height:2.25rem;background:color-mix(in srgb, var(--bs-{{ color }}) 15%, transparent);">
                    <span class="text-{{ color }}">
                        <twig:ux:icon name="{{ icon }}" style="width:1.1rem;height:1.1rem;" />
                    </span>
                </div>
            </div>
            <div class="fs-2 fw-bold lh-1 text-{{ color }}">{{ value }}</div>
            {% if sub is not null %}
                <p class="text-muted small mb-0">{{ sub }}</p>
            {% endif %}
        </div>
    {% endif %}
</div>
