{% props messages = [] %}

<div
    class="fixed inset-x-0 top-18 flex flex-col items-end justify-right px-4 py-6 sm:p-6 justify-end z-60
    pointer-events-none"
>
  {# Read and Display all Notifications messages #}
  {% for label, msgs in messages %}
    {% set show_divider = true %}

    {% for message in msgs %}
      {% set duration = 5000 %}

      {% if message is iterable %}
        {% set title = message.title|default('') %}
        {% set message = message.message %}
        {% set duration = message.duration|default(duration) %}
      {% endif %}

      {% set duration = duration + (loop.parent.loop.index0 * 5000) %}

      <twig:Ui:Notification
          :id="label ~ '-' ~ loop.parent.loop.index0"
          :variant="label"
          :description="message"
          :duration="duration"
      >
        <twig:ux:icon :name="icon_name" class="size-5" />
        {% if title is not empty %}
          <twig:Ui:Notification:Title>{{ outerScope.title }}</twig:Ui:Notification:Title>
        {% endif %}
        <twig:Ui:Notification:Description>{{ outerScope.description }}</twig:Ui:Notification:Description>
        {% if closable is same as(true) %}
          <twig:Ui:Notification:Closable />
        {% endif %}
      </twig:Ui:Notification>
    {% endfor %}
  {% endfor %}
</div>
