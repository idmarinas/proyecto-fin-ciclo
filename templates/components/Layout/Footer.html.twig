<footer
    data-slot="footer"
    class="{{ ('container bg-background px-4 py-6 mx-auto' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes }}
>
  {% if not app.user %}
    <twig:Ui:Separator class="h-0.5 my-4" />
    <twig:Layout:CtaRegister />
  {% endif %}

  <twig:Ui:Separator class="h-0.5 my-4" />

  <div class="flex flex-col md:flex-row-reverse items-center justify-center gap-4">
    <div class="w-full md:w-96 flex flex-col text-center">
      <h5 class="text-2xl text-primary">
        <twig:ux:icon name="tabler:prism-light" class="w-15 h-15 inline stroke-1" /> {{ app_title }}
      </h5>
      <div>
        En Lúmina transformamos la tecnología en algo claro, accesible y confiable, acompañándote con soporte experto
        cuando más lo necesitas.
      </div>
    </div>
    <div class="flex-1 grid grid-cols-3 md:grid-cols-5 gap-4 justify-start text-center">
      <div>
        <h6 class="text-xl">
          <twig:ux:icon name="tabler:building-skyscraper" class="inline" />
          Compañía
        </h6>
        <ul class="mt-2 space-y-1 text-sm">
          <li>
            <twig:Ui:Button as="a" variant="link" href="{{ path('app_home') }}">
              Inicio
            </twig:Ui:Button>
          </li>
          <li>
            <twig:Ui:Button as="a" variant="link" href="{{ path('app_legal_sobre_nosotros') }}">
              Sobre nosotros
            </twig:Ui:Button>
          </li>
        </ul>
      </div>
      <div>
        <h6 class="text-xl">{{ ux_icon('tabler:file-text', {class: 'inline'}) }} Legal</h6>
        <ul class="mt-2 space-y-1 text-sm">
          <li>
            <twig:Ui:Button as="a" variant="link" href="{{ path('app_legal_aviso_legal') }}">
              Aviso Legal
            </twig:Ui:Button>
          </li>
          <li>
            <twig:Ui:Button as="a" variant="link" href="{{ path('app_legal_privacidad') }}">
              Privacidad
            </twig:Ui:Button>
          </li>
          <li>
            <twig:Ui:Button as="a" variant="link" href="{{ path('app_legal_cookies') }}">
              Cookies
            </twig:Ui:Button>
          </li>
          <li>
            <twig:Ui:Button as="a" variant="link" href="{{ path('app_legal_terminos') }}">
              Términos de uso
            </twig:Ui:Button>
          </li>
        </ul>
      </div>
      <div>
        <h6 class="text-xl">
          <twig:ux:icon name="tabler:mail" class="inline" />
          Contacto
        </h6>
      </div>
    </div>
  </div>

  <twig:Ui:Separator class="h-0.5 my-4" />

  <div class="rounded-xl bg-primary/8 border border-primary/20 px-6 py-8">
    <div class="flex flex-col md:flex-row md:items-center gap-6">
      <twig:Ui:Item class="flex-1">
        <twig:Ui:Item:Content>
          <twig:Ui:Item:Title class="text-base font-semibold text-foreground flex items-center gap-2">
            <twig:ux:icon name="tabler:mail-forward" class="size-5 text-primary" />
            Suscríbase a nuestro boletín informativo
          </twig:Ui:Item:Title>
          <twig:Ui:Item:Description class="mt-1 text-sm text-muted-foreground">
            Las últimas noticias, artículos y recursos, enviados semanalmente a tu bandeja de entrada.
          </twig:Ui:Item:Description>
        </twig:Ui:Item:Content>
      </twig:Ui:Item>
      <div class="flex flex-col sm:flex-row gap-3 md:flex-none">
        <twig:Ui:InputGroup class="w-full sm:w-72">
          <twig:Ui:InputGroup:Input id="email" name="email" type="email" placeholder="Escribe tu email" />
          <twig:Ui:InputGroup:Icon position="end">
            <twig:ux:icon name="tabler:mail" />
          </twig:Ui:InputGroup:Icon>
        </twig:Ui:InputGroup>
        <twig:Ui:Button size="lg" class="w-full sm:w-auto">Subscribirse</twig:Ui:Button>
      </div>
    </div>
  </div>

  <twig:Ui:Separator class="h-0.5 my-4" />

  <div class="flex flex-col-reverse md:flex-row items-center justify-center gap-1">
    <div class="flex-none text-center">
      <twig:ux:icon name="tabler:copyright" class="inline h-5 w-5" /> {{ 'now'|date('Y') }}
      - {{ app_title }}, Lúmina Servicios Tecnológicos
    </div>
    <div class="hidden md:block flex-1"></div>
    <div class="flex gap-3">
      <a href="#"
         aria-label="Twitter / X"
         class="p-2 rounded-lg text-muted-foreground hover:text-primary hover:bg-primary/10 transition-colors duration-150">
        <twig:ux:icon name="tabler:brand-twitter" class="h-5 w-5" />
      </a>
      <a href="#"
         aria-label="Facebook"
         class="p-2 rounded-lg text-muted-foreground hover:text-primary hover:bg-primary/10 transition-colors duration-150">
        <twig:ux:icon name="tabler:brand-facebook" class="h-5 w-5" />
      </a>
      <a href="#"
         aria-label="Instagram"
         class="p-2 rounded-lg text-muted-foreground hover:text-primary hover:bg-primary/10 transition-colors duration-150">
        <twig:ux:icon name="tabler:brand-instagram" class="h-5 w-5" />
      </a>
      <a href="#"
         aria-label="LinkedIn"
         class="p-2 rounded-lg text-muted-foreground hover:text-primary hover:bg-primary/10 transition-colors duration-150">
        <twig:ux:icon name="tabler:brand-linkedin" class="h-5 w-5" />
      </a>
      <a href="#"
         aria-label="GitHub"
         class="p-2 rounded-lg text-muted-foreground hover:text-primary hover:bg-primary/10 transition-colors duration-150">
        <twig:ux:icon name="tabler:brand-github" class="h-5 w-5" />
      </a>
      <a href="#"
         aria-label="YouTube"
         class="p-2 rounded-lg text-muted-foreground hover:text-primary hover:bg-primary/10 transition-colors duration-150">
        <twig:ux:icon name="tabler:brand-youtube" class="h-5 w-5" />
      </a>
      <a href="#"
         aria-label="Discord"
         class="p-2 rounded-lg text-muted-foreground hover:text-primary hover:bg-primary/10 transition-colors duration-150">
        <twig:ux:icon name="tabler:brand-discord" class="h-5 w-5" />
      </a>
    </div>
  </div>
</footer>
