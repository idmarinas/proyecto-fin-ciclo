<footer
    class="{{ ('container bg-background px-4 py-6 mx-auto' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes }}
>
  {% if not app.user %}
    <twig:Separator class="h-0.5 my-4" />
    <twig:Layout:CtaRegister />
  {% endif %}

  <twig:Separator class="h-0.5 my-4" />

  <div class="flex flex-col md:flex-row-reverse items-center justify-center gap-4">
    <div class="w-full md:w-96 flex flex-col text-center">
      <h5 class="text-2xl text-primary">
        <twig:ux:icon name="tabler:prism-light" class="w-15 h-15 inline stroke-1" /> {{ app_title }}
      </h5>
      <div>
        En Lúmina transformamos la tecnología en algo claro, accesible y confiable, acompañándote con soporte experto
        cuando más lo necesitas.
      </div>
    </div>
    <div class="flex-1 grid grid-cols-3 md:grid-cols-5 gap-4 justify-start">
      <div>
        <h6>
          <twig:ux:icon name="tabler:building-skyscraper" class="inline" />
          Compañía
        </h6>
      </div>
      <div>
        <h6>
          <twig:ux:icon name="tabler:file-text" class="inline" />
          Legal
        </h6>
      </div>
      <div>
        <h6>
          <twig:ux:icon name="tabler:mail" class="inline" />
          Contacto
        </h6>
      </div>
    </div>
  </div>

  <twig:Separator class="h-0.5 my-4" />

  <div class="flex flex-col md:flex-row md:items-center justify-center gap-4">
    <div class="flex-1 md:flex-none">
      <twig:Item>
        <twig:Item:Content>
          <twig:Item:Title>Suscríbase a nuestro boletín informativo</twig:Item:Title>
          <twig:Item:Description>
            Las últimas noticias, artículos y recursos, enviados semanalmente a tu bandeja de entrada.
          </twig:Item:Description>
        </twig:Item:Content>
      </twig:Item>
    </div>
    <div class="hidden md:block flex-1"></div>
    <div class="flex-1 md:flex-none flex flex-col md:flex-row gap-4">
      <twig:InputGroup class="w-full md:w-auto">
        <twig:InputGroup:Input id="email" name="email" type="email" placeholder="Escribe tu email" />
        <twig:InputGroup:Icon position="end">
          <twig:ux:icon name="tabler:mail" />
        </twig:InputGroup:Icon>
      </twig:InputGroup>

      <twig:Button variant="outline" size="lg" class="w-full md:w-auto">Subscribirse</twig:Button>
    </div>
  </div>

  <twig:Separator class="h-0.5 my-4" />

  <div class="flex flex-col-reverse md:flex-row items-center justify-center gap-1">
    <div class="flex-none text-center">
      <twig:ux:icon name="tabler:copyright" class="inline h-5 w-5" /> {{ 'now'|date('Y') }}
      - {{ app_title }}, Lúmina Servicios Tecnológicos
    </div>
    <div class="hidden md:block flex-1"></div>
    <div class="flex gap-4">
      <twig:ux:icon name="tabler:brand-twitter" class="h-7 w-7" />
      <twig:ux:icon name="tabler:brand-facebook" class="h-7 w-7" />
      <twig:ux:icon name="tabler:brand-instagram" class="h-7 w-7" />
      <twig:ux:icon name="tabler:brand-linkedin" class="h-7 w-7" />
      <twig:ux:icon name="tabler:brand-github" class="h-7 w-7" />
      <twig:ux:icon name="tabler:brand-youtube" class="h-7 w-7" />
      <twig:ux:icon name="tabler:brand-discord" class="h-7 w-7" />
    </div>
  </div>
</footer>
