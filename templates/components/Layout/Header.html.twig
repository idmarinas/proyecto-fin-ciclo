<header
    class="{{ ('sticky top-0 border-b-2 border-b-gray-300 backdrop-blur-xs z-50 ' ~ attributes.render('class'))
    |tailwind_merge }}"
    {{ attributes }}
>
  <nav aria-label="Global" class="mx-auto flex max-w-7xl items-center justify-center lg:justify-between p-6 lg:px-8">
    <div class="flex lg:flex-1">
      <a href="{{ path('app_home') }}" class="-m-1.5 p-1.5">
        <span class="sr-only">{{ app_title }}</span>
        <img
            src="{{ asset('images/public_thread.webp') }}"
            alt=""
            class="h-9 w-auto"
        />
      </a>
    </div>
    <div class="hidden lg:flex lg:flex-1 lg:justify-end">
      <twig:Ui:Button variant="link" as="a" href="{{ path('app_user_login') }}">
        Conectar
        <twig:ux:icon name="tabler:login" />
      </twig:Ui:Button>
      <twig:Ui:Button as="a" href="{{ path('app_user_register') }}">
        Registrarse
        <twig:ux:icon name="tabler:user-plus" />
      </twig:Ui:Button>
    </div>
  </nav>
</header>
