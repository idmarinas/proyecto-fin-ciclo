<header
    data-slot="header"
    class="{{ ('sticky top-0 bg-background/95 backdrop-blur-sm border-b-2 border-b-border z-50 ' ~ attributes.render('class'))
    |tailwind_merge }}"
    {{ attributes }}
>
  <nav aria-label="Global" class="mx-auto flex max-w-7xl items-center justify-center lg:justify-between p-6 lg:px-8">
    <div class="flex flex-1">
      <a href="{{ path('app_home') }}" class="hover:bg-black/20 dark:hover:bg-white/20 rounded-md">
        <span class="sr-only">{{ app_title }}</span>
        <img src="{{ asset('images/public_thread.webp') }}" alt="" class="h-10 w-auto inline-block" />
        <span class="md:hidden font-medium">{{ app_title }}</span>
      </a>
    </div>
    <div class="flex">
      {% include 'layouts/menus/responsive_menu.html.twig' %}
    </div>
    <div class="hidden md:flex md:flex-1 md:justify-end gap-2">
      {% if app.user is empty %}
        <twig:App:Nav:Anonymous />
      {% else %}
        <twig:App:Nav:Profile />
      {% endif %}
    </div>
  </nav>
</header>
