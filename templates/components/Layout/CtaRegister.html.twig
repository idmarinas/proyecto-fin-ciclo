<div
    class="{{ ('px-6 py-12 sm:px-12 sm:py-24 lg:px-16 lg:py-24 ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes }}
>
  <div class="flex flex-col lg:grid gap-8 sm:gap-16 max-w-2xl mx-auto text-center">
    <h4 class="text-3xl sm:text-4xl text-pretty tracking-tight font-bold text-highlighted">
      Participa, aprende y aporta
    </h4>
    <p class="text-base sm:text-lg">
      Forma parte del foro de Lúmina y descubre respuestas, guías y conversaciones que te ayudarán a sacar más partido a
      nuestros servicios.
    </p>
    <div class="flex justify-center items-center">
      <twig:Ui:Button as="a" href="{{ path('app_user_register') }}">
        <twig:ux:icon name="tabler:user-plus" class="inline" />
        Crear cuenta
      </twig:Ui:Button>
    </div>
  </div>
</div>
