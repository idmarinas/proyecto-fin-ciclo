{% props messages = [] %}

{% set show_divider = messages is not empty %}

{# Read and Display all Flash Messages #}
{% for label, msgs in messages %}
  {% for message in msgs %}
    {% if message is iterable %}
      {% set title = message.title %}
      {% set message = message.message %}
    {% endif %}

    <twig:Ui:Alert :variant="label" :title="title|default('')" :description="message">
      <twig:ux:icon :name="icon_name" class="size-4" />
      {% if title is not empty %}
        <twig:Ui:Alert:Title>{{ outerScope.title }}</twig:Ui:Alert:Title>
      {% endif %}
      <twig:Ui:Alert:Description>{{ outerScope.description }}</twig:Ui:Alert:Description>
    </twig:Ui:Alert>
  {% endfor %}
{% endfor %}

{% if show_divider %}
  <twig:Ui:Separator class="hidden sm:block" />
{% endif %}
