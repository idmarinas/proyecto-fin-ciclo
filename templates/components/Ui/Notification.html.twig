{# @var attributes \Symfony\UX\TwigComponent\ComponentAttributes #}

{% props variant, duration = 5000 %}

{# 'border-l-4 motion-safe:transition motion-safe:transform motion-safe:duration-1000 max-w-sm w-full shadow-lg px-4
py-3 mb-4 rounded relative pointer-events-auto' #}

{% set style = html_cva(
  base: 'relative rounded border-l-4 px-4 py-3 mb-4 w-full max-w-sm shadow-lg p-4 motion-safe:transition
  motion-safe:transform motion-safe:duration-1000 [&>svg~*]:pl-7 [&>svg+div]:translate-y-[-3px] [&>svg]:absolute [&>svg]:left-4 [&>svg]:top-4 [&>svg]:text-foreground pointer-events-auto',
  variants: {
    variant: {
      default: 'bg-background text-foreground',
      destructive: 'border-destructive/50 text-destructive dark:border-destructive [&>svg]:text-destructive',
      error: 'bg-error text-error-foreground border-error-border [&>svg]:text-error-foreground',
      danger: 'bg-danger text-danger-foreground border-danger-border [&>svg]:text-danger-foreground',
      success: 'bg-success text-success-foreground border-success-border [&>svg]:text-success-foreground',
      warning: 'bg-warning text-warning-foreground border-warning-border [&>svg]:text-warning-foreground',
      info: 'bg-info text-info-foreground border-info-border [&>svg]:text-info-foreground',
      notice: 'bg-notice text-notice-foreground border-notice-border [&>svg]:text-notice-foreground',
    }
  },
  default_variant: {
    variant: 'notice'
  }
) %}

<div
    role="alert"
    class="{{ style.apply({ variant }, attributes.render('class'))|tailwind_merge }}"
    {{ attributes.defaults({
      'data-controller': 'notification',
      'data-notification-delay-value': duration,
      'data-transition-enter-from': 'opacity-0 translate-x-6',
      'data-transition-enter-to': 'opacity-100 translate-x-0',
      'data-transition-leave-from': 'opacity-100 translate-x-0',
      'data-transition-leave-to': 'opacity-0 translate-x-6'
    }) }}
>
  {% block content %}{% endblock %}
</div>
