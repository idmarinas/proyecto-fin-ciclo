{# @prop variant 'default'|'destructive' The variant, default to `default` #}
{# @block content The default block #}
{%- props variant = 'default' -%}
{%- set style = html_cva(
  base: 'relative w-full rounded-lg border p-4 [&>svg~*]:pl-7 [&>svg+div]:translate-y-[-3px] [&>svg]:absolute [&>svg]:left-4 [&>svg]:top-4 [&>svg]:text-foreground',
  variants: {
    variant: {
      default: 'bg-background text-foreground',
      destructive: 'border-destructive/50 text-destructive dark:border-destructive [&>svg]:text-destructive',
      error: 'bg-error text-error-foreground border-error/50 dark:border-error [&>svg]:text-error-foreground',
      danger: 'bg-danger text-danger-foreground border-dange/50 dark:border-dange [&>svg]:text-dange-foreground',
      success: 'bg-success text-success-foreground border-success dark:border-success [&>svg]:text-success-foreground',
      warning: 'bg-warning text-warning-foreground border-warning dark:border-warning [&>svg]:text-warning-foreground',
      info: 'bg-info text-info-foreground border-info dark:border-info [&>svg]:text-info-foreground',
      notice: 'bg-notice text-notice-foreground border-notice dark:border-notice [&>svg]:text-notice-foreground',
    },
  },
) -%}

<div
    class="{{ style.apply({variant}, attributes.render('class'))|tailwind_merge }}"
    role="alert"
    {{ attributes }}
>
  {%- block content %}{% endblock -%}
</div>
