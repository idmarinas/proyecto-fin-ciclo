{# @prop variant 'default'|'destructive' The variant, default to `default` #}
{# @block content The default block #}
{%- props variant = 'default' -%}
{%- set style = html_cva(
  base: "grid gap-0.5 rounded-lg border px-2.5 py-2 text-left text-sm has-data-[slot=alert-action]:relative has-data-[slot=alert-action]:pr-18 has-[>svg]:grid-cols-[auto_1fr] has-[>svg]:gap-x-2 *:[svg]:row-span-2 *:[svg]:translate-y-0.5 *:[svg]:text-current *:[svg:not([class*='size-'])]:size-4 w-full relative group/alert",
  variants: {
    variant: {
      default: 'bg-card text-card-foreground',
      destructive: 'text-destructive bg-card *:data-[slot=alert-description]:text-destructive/90 *:[svg]:text-current',
      error: 'bg-error text-error-foreground bg-card *:data-[slot=alert-description]:text-error-foreground/90 *:[svg]:text-current',
      danger: 'bg-danger text-danger-foreground bg-card *:data-[slot=alert-description]:text-danger-foreground/90 *:[svg]:text-current',
      success: 'bg-success text-success-foreground bg-card *:data-[slot=alert-description]:text-success-foreground/90 *:[svg]:text-current',
      warning: 'bg-warning text-warning-foreground bg-card *:data-[slot=alert-description]:text-warning-foreground/90 *:[svg]:text-current',
      info: 'bg-info text-info-foreground bg-card *:data-[slot=alert-description]:text-info-foreground/90 *:[svg]:text-current',
      notice: 'bg-notice text-notice-foreground bg-card *:data-[slot=alert-description]:text-notice-foreground/90 *:[svg]:text-current',
    },
  },
) -%}

<div
    data-slot="alert"
    role="alert"
    class="{{ style.apply({variant: variant}, attributes.render('class'))|tailwind_merge }}"
    {{ attributes }}
>
  {%- block content %}{% endblock -%}
</div>
