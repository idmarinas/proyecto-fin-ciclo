<twig:Ui:Pagination:Link
    aria-label="Ir a la página siguiente"
    size="default"
    class="{{ ('gap-1 pr-2.5 ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ ...attributes.without('class') }}
>
  <span>Siguiente</span>
  <twig:ux:icon name="tabler:chevron-right" class="size-4" />
</twig:Ui:Pagination:Link>
