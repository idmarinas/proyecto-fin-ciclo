<span class="absolute top-2 right-3">
  <twig:Ui:Button
      type="button"
      variant="outline"
      aria-label="{{ 'notification.close'|trans(domain = 'IdmUiBundle') }}"
      data-action="click->notification#hide"
      size="icon-xs"
      class="{{ ('transition ease-in-out duration-150 ' ~ attributes.render('class'))|tailwind_merge }}"
  >
  <twig:ux:icon name="close" class="size-4" />
</twig:Ui:Button>
</span>
