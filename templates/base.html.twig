<!DOCTYPE html>
<html lang="{{ app.request.locale }}" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="distribution" content="global" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta name="csp-nonce" content="{{ csp_nonce('script') }}" data-turbo-track="reload" />
  <meta name="turbo-visit-control" content="reload" />
  <meta name="view-transition" content="same-origin">
  <meta name="turbo-refresh-scroll" content="preserve" />
  <meta name="turbo-refresh-method" content="replace">

  <title>{% block title %}{{ idm_seo_title() }}{% endblock %}</title>

  <!-- Favicons -->
  <link rel="icon" href="/favicons/favicon.png" type="image/png">
  <link rel="icon" href="/favicons/favicon-32x32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/favicons/favicon-16x16.png" sizes="16x16" type="image/png">
  <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" sizes="180x180">
  <link rel="manifest" href="/site.webmanifest">

  {# IDMarinas SEO Bundle Meta Tags #}
  {{ idm_seo_meta() }}
  {{ idm_seo_open_graph() }}
  {{ idm_seo_twitter() }}

  {# Meta tags personalizados #}
  {% block header_meta %}{% endblock %}

  {# Importmaps personalizados #}
  {% block importmap %}
    {{ importmap('app', { 'nonce': csp_nonce('script') }) }}
  {% endblock %}

  {% block stylesheets %}{% endblock %}

  {% block javascripts %}{% endblock %}
</head>
<body class="h-full w-full">
  {% block body %}
    {% block header %}
      <twig:Layout:Header />
    {% endblock %}

    {% block main %}
      <main class="group/main container mx-auto p-4 has-data-[slot=aside]:grid has-data-[slot=aside]:grid-cols-1 has-data-[slot=aside]:lg:grid-cols-4 has-data-[slot=aside]:gap-10">
        {% block flash %}
          <twig:Layout:FlashMessages />
        {% endblock flash %}

        {% block article %}{% endblock %}

        {% block aside %}{% endblock %}
      </main>
    {% endblock main %}

    {% block footer %}
      <twig:Layout:Footer />
    {% endblock footer %}
  {% endblock body %}

  {% block notifications %}
    <twig:Layout:NotificationMessages />
  {% endblock notifications %}
</body>
</html>
