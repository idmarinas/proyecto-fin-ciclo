{% extends 'emails/base.html.twig' %}


{% block body %}
  {% block styles %}
    <style>
      body,
      html,
      .body {
        background: #f3f3f3 !important;
      }

      .header {
        background: #f3f3f3;
      }
    </style>
  {% endblock %}
  <spacer size="16"></spacer>

  <container>

    <row class="header">
      <columns>

        <spacer size="16"></spacer>

        <h4 class="text-center">{{ app_title }}</h4>
      </columns>
    </row>
    <row>
      <columns>

        <spacer size="32"></spacer>

        <center>
          <img src="{{ email.image('@images/favicons/favicon-512x512.png') }}" alt="" width="250" height="250" />
        </center>

        <spacer size="16"></spacer>

        <h1 class="text-center">¿Olvidaste la contraseña?</h1>

        <spacer size="16"></spacer>

        <p class="text-center">Suele ocurrir. Haga clic en el enlace siguiente para restablecer su contraseña.</p>
        <button class="large expand" href="{{ url('app_user_reset_password', {token: resetToken.token}) }}">
          Restablecer contraseña
        </button>

        <p>
          Este enlace caducará en
          {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
        </p>
      </columns>
    </row>

    <spacer size="16"></spacer>
  </container>

{% endblock %}
